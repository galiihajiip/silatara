{
  "name": "silatara-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:worker": "esbuild src/features/practice/worker/landmarker.worker.ts --bundle --format=iife --target=es2022 --minify --tsconfig=tsconfig.json --outfile=public/mediapipe/worker/landmarker.worker.js"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3",
    "lucide-react": "1.76.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.1"
  }
}
